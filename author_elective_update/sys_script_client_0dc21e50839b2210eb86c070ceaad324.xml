        <messages/>
        <name>NeedIt Populate Email on Create</name>
        <order/>
        <script><![CDATA[function onLoad() {
  // Only run for new records
  if (!g_form.isNewRecord()) {
    return;
  }

  // Get the value of the Requested for field
  var requestedForValue = g_form.getValue('u_requested_for');

  // If it has a value and the email field is empty, fetch the email
  if (requestedForValue && !g_form.getValue('u_requested_for_email')) {
    var getEmailAddr = new GlideAjax('GetEmailAddress');
    getEmailAddr.addParam('sysparm_name', 'getEmail');
    getEmailAddr.addParam('sysparm_userID', requestedForValue);
    getEmailAddr.getXML(function(response) {
      var emailFromScriptInclude = response.responseXML.documentElement.getAttribute("answer");
      g_form.setValue('u_requested_for_email', emailFromScriptInclude);
    });
  }
}
]]></script>
